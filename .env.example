# Copy to .env.local and fill in. Never commit the filled file — .gitignore
# already excludes .env*, keep it that way.

# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co. The public copy is required
# by Supabase Auth in the browser; the server-only alias keeps existing server
# integrations backwards-compatible during rollout.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=

# Publishable (anon) key. This key is safe to expose, but it must only be used
# for Auth in browser code; participant data continues through server actions.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical app origin used for Auth email redirects. No trailing slash.
# Local example: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Service role key. Bypasses Row Level Security, so it is server-only.
# It must NEVER be prefixed with NEXT_PUBLIC_ — that would ship it to browsers
# and hand anyone full read/write access to participant data.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin, quiz and plan-link signing --------------------------------------
# Use separate random values of at least 32 bytes. Never reuse the password as
# a signing secret, and never share one secret between two of these: each
# scopes a different kind of token, and a shared secret would let one be
# replayed as another.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
QUIZ_SESSION_SECRET=
# Signs the /plan links Radoslava shares. Rotating it invalidates every
# outstanding link at once — which is also the only way to revoke one.
# Missing in production: every plan link returns 404.
PLAN_ACCESS_SECRET=

# --- Resend -----------------------------------------------------------------
RESEND_API_KEY=
# Must be a verified sender before production.
RESEND_FROM_EMAIL=
RESEND_ADMIN_EMAIL=

# --- Cloudflare Turnstile (bot protection) ----------------------------------
# https://dash.cloudflare.com -> Turnstile -> Add site
# The site key is public by design and is rendered into the page.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# The secret key is server-only. If it is missing in production the form
# rejects every submission — set it in Vercel before deploying.
TURNSTILE_SECRET_KEY=

# --- Upstash Redis (rate limiting) ------------------------------------------
# https://console.upstash.com -> Create database -> REST API
# If these are missing the form still works, but without any rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
