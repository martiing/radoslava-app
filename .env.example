# Copy to .env.local and fill in. Never commit the filled file — .gitignore
# already excludes .env*, keep it that way.

# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Service role key. Bypasses Row Level Security, so it is server-only.
# It must NEVER be prefixed with NEXT_PUBLIC_ — that would ship it to browsers
# and hand anyone full read/write access to participant data.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin and quiz sessions -----------------------------------------------
# Use separate random values of at least 32 bytes. Never reuse the password as
# either signing secret.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
QUIZ_SESSION_SECRET=

# --- Resend -----------------------------------------------------------------
RESEND_API_KEY=
# Must be a verified sender before production.
RESEND_FROM_EMAIL=
RESEND_ADMIN_EMAIL=

# --- Cloudflare Turnstile (bot protection) ----------------------------------
# https://dash.cloudflare.com -> Turnstile -> Add site
# The site key is public by design and is rendered into the page.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# The secret key is server-only. If it is missing in production the form
# rejects every submission — set it in Vercel before deploying.
TURNSTILE_SECRET_KEY=

# --- Upstash Redis (rate limiting) ------------------------------------------
# https://console.upstash.com -> Create database -> REST API
# If these are missing the form still works, but without any rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
